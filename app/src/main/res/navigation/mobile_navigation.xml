<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.dwas_11.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_explore"
        android:name="com.example.dwas_11.ui.explore.ExploreFragment"
        android:label="Explore"
        tools:layout="@layout/fragment_explore" />

    <fragment
        android:id="@+id/navigation_trips"
        android:name="com.example.dwas_11.ui.trips.TripsFragment"
        android:label="Trips"
        tools:layout="@layout/fragment_trips" />

    <fragment
        android:id="@+id/navigation_bookings"
        android:name="com.example.dwas_11.ui.bookings.BookingsFragment"
        android:label="Bookings"
        tools:layout="@layout/fragment_bookings" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.dwas_11.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/navigation_solo_traveler"
        android:name="com.example.dwas_11.ui.solotraveler.SoloTravelerFragment"
        android:label="Solo Travel"
        tools:layout="@layout/fragment_solo_traveler" />
</navigation> 