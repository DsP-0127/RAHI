<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/language_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Language"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dark_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/language_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose your preferred language"
            android:textSize="14sp"
            android:textColor="@color/gray"
            app:layout_constraintStart_toStartOf="@id/language_title"
            app:layout_constraintTop_toBottomOf="@id/language_title" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_gray"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/language_subtitle" />

        <!-- Language Options -->
        <RadioGroup
            android:id="@+id/language_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/divider">

            <!-- English -->
            <RadioButton
                android:id="@+id/lang_english"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="English"
                android:checked="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Hindi -->
            <RadioButton
                android:id="@+id/lang_hindi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="हिन्दी (Hindi)"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Bengali -->
            <RadioButton
                android:id="@+id/lang_bengali"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="বাংলা (Bengali)"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Tamil -->
            <RadioButton
                android:id="@+id/lang_tamil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="தமிழ் (Tamil)"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Telugu -->
            <RadioButton
                android:id="@+id/lang_telugu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="తెలుగు (Telugu)"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </RadioGroup>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/language_cancel_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cancel"
            android:textColor="@color/gray"
            app:layout_constraintEnd_toStartOf="@id/language_apply_button"
            app:layout_constraintTop_toBottomOf="@id/language_radio_group" />

        <Button
            android:id="@+id/language_apply_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply"
            android:textColor="@color/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/language_cancel_button" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView> 