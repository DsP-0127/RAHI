<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Destination Image with Scrim -->
        <ImageView
            android:id="@+id/destination_image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:elevation="1dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="Destination photo" />
            
        <!-- Scrim overlay on image -->
        <View
            android:id="@+id/image_scrim"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:background="@drawable/gradient_scrim"
            android:elevation="2dp"
            app:layout_constraintBottom_toBottomOf="@id/destination_image"
            app:layout_constraintStart_toStartOf="@id/destination_image"
            app:layout_constraintEnd_toEndOf="@id/destination_image" />

        <!-- Favorite Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/favorite_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="12dp"
            android:src="@drawable/ic_favorite_border"
            app:fabSize="mini"
            app:tint="@color/white"
            app:rippleColor="#80FFFFFF"
            app:elevation="6dp"
            app:borderWidth="0dp"
            app:maxImageSize="20dp"
            app:backgroundTint="@color/colorAccent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="Add to favorites" />

        <!-- Destination Name on Image -->
        <TextView
            android:id="@+id/destination_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:shadowColor="@color/black"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="@id/destination_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Paris" />

        <!-- Location with Icon -->
        <ImageView
            android:id="@+id/location_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_location"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            app:tint="@color/gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/destination_image"
            android:contentDescription="Location" />
            
        <TextView
            android:id="@+id/destination_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/gray"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@id/location_icon"
            app:layout_constraintTop_toTopOf="@id/location_icon"
            app:layout_constraintBottom_toBottomOf="@id/location_icon"
            tools:text="France" />

        <!-- Price and Rating Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/price_rating_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/location_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Price with Label -->
            <TextView
                android:id="@+id/price_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Starting from"
                android:textSize="12sp"
                android:textColor="@color/gray"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
                
            <TextView
                android:id="@+id/destination_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/price_color"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/price_label"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="₹99,600" />
                
            <!-- Rating with Stars -->
            <LinearLayout
                android:id="@+id/rating_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                
                <ImageView
                    android:id="@+id/star_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star"
                    app:tint="@color/rating_color" />
                    
                <TextView
                    android:id="@+id/destination_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_gray"
                    android:layout_marginStart="4dp"
                    tools:text="4.5" />
                    
                <TextView
                    android:id="@+id/review_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/gray"
                    android:layout_marginStart="4dp"
                    tools:text="(100)" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Destination Features -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/light_gray"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/price_rating_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Weather Feature -->
        <ImageView
            android:id="@+id/weather_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_weather"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            app:tint="@color/flight_color"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"
            android:contentDescription="Weather" />
            
        <TextView
            android:id="@+id/weather"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/dark_gray"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/weather_icon"
            app:layout_constraintTop_toTopOf="@id/weather_icon"
            app:layout_constraintBottom_toBottomOf="@id/weather_icon"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="25°C, Sunny" />

        <!-- Best Time Feature -->
        <ImageView
            android:id="@+id/calendar_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_calendar"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            app:tint="@color/hotel_color"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/weather_icon"
            android:contentDescription="Best time to visit" />
            
        <TextView
            android:id="@+id/best_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/dark_gray"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/calendar_icon"
            app:layout_constraintTop_toTopOf="@id/calendar_icon"
            app:layout_constraintBottom_toBottomOf="@id/calendar_icon"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Best time: April-June" />

        <!-- Tags -->
        <HorizontalScrollView
            android:id="@+id/tags_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/best_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/tags_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:chipSpacing="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/tag_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipBackgroundColor="@color/tag_background"
                    android:textColor="@color/tag_text"
                    android:textSize="12sp"
                    app:chipMinHeight="28dp"
                    tools:text="Cultural" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tag_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipBackgroundColor="@color/tag_background"
                    android:textColor="@color/tag_text"
                    android:textSize="12sp"
                    app:chipMinHeight="28dp"
                    tools:text="History" />
                    
                <com.google.android.material.chip.Chip
                    android:id="@+id/distance_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipBackgroundColor="@color/colorPrimaryLight"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"
                    app:chipMinHeight="28dp"
                    app:chipIcon="@drawable/ic_distance"
                    app:chipIconTint="@color/colorPrimary"
                    tools:text="7,850 km" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView> 