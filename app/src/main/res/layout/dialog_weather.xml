<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header Section -->
        <TextView
            android:id="@+id/weather_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Weather"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dark_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/weather_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last updated 5 min ago"
            android:textSize="12sp"
            android:textColor="@color/gray"
            app:layout_constraintStart_toStartOf="@id/weather_title"
            app:layout_constraintTop_toBottomOf="@id/weather_title" />
            
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_gray"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/weather_update_time" />

        <!-- Current Weather Section -->
        <ImageView
            android:id="@+id/weather_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_weather_sunny"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"
            android:contentDescription="Weather Icon" />

        <TextView
            android:id="@+id/weather_location_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Current Location"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dark_gray"
            app:layout_constraintStart_toEndOf="@id/weather_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/weather_icon" />

        <TextView
            android:id="@+id/weather_temp_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="22°C"
            android:textSize="20sp"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/weather_location_name"
            app:layout_constraintTop_toBottomOf="@id/weather_location_name" />

        <TextView
            android:id="@+id/weather_condition_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Sunny"
            android:textSize="14sp"
            android:textColor="@color/gray"
            app:layout_constraintStart_toEndOf="@id/weather_temp_value"
            app:layout_constraintBottom_toBottomOf="@id/weather_temp_value" />

        <!-- Destination Weather Section -->
        <TextView
            android:id="@+id/destination_weather_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Weather at Popular Destinations"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dark_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/weather_icon" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/destination_weather_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="100dp"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/destination_weather_title" />

        <!-- Action Buttons -->
        <Button
            android:id="@+id/weather_close_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Close"
            android:textColor="@color/gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/destination_weather_recycler" />

        <Button
            android:id="@+id/weather_refresh_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Refresh"
            android:textColor="@color/colorPrimary"
            app:layout_constraintEnd_toStartOf="@id/weather_close_button"
            app:layout_constraintTop_toTopOf="@id/weather_close_button" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView> 