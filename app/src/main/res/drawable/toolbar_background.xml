<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#102E65"
                android:centerColor="#0D47A1"
                android:endColor="#1A73E8"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Subtle pattern -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08FFFFFF" />
        </shape>
    </item>
    
    <!-- Bottom shadow line -->
    <item android:top="?attr/actionBarSize">
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <gradient
                android:angle="90"
                android:endColor="#1A000000"
                android:startColor="#33000000" />
        </shape>
    </item>
</layer-list> 